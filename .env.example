# =============================================================================
# Vantage - environment configuration
#
# Copy to `.env.local` for development:   cp .env.example .env.local
# For Vercel: add these under Project Settings > Environment Variables.
#
# EVERYTHING HERE IS OPTIONAL FOR `npm run dev` TO BOOT.
# The app starts with zero configuration and tells you exactly what is missing
# when you reach a feature that needs it. See `GET /api/setup`.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenRouter  (required for anything that generates)
# -----------------------------------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_ -- there is a test that fails the
# build if this value appears in client code. See src/lib/openrouter/server-only.ts
OPENROUTER_API_KEY=

# Optional hosted Postgres. Leave blank to use local PGlite in development.
DATABASE_URL=

# Optional. Sent as the HTTP-Referer / X-Title headers OpenRouter asks for, and
# used to identify your workspace in their dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Auth + Storage  (optional -- local fallbacks exist for both)
# -----------------------------------------------------------------------------
# Local email/password accounts work without Supabase. On Vercel, set the project
# URL and service-role key for durable storage; leave the anon key blank to keep
# the local email/password auth flow.
#
# Project URL and anon key: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Used for the admin client (service role) which bypasses RLS.
# Needed ONLY if you enable Supabase Storage as the driver. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for OAuth redirects and for building shareable URLs.
# On Vercel this is auto-detected; set it explicitly if you use a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Storage driver
# -----------------------------------------------------------------------------
# local    -> writes to ./storage/local, served by a Next route handler.
#            Zero setup, zero egress cost, works on the free tier. Default.
# supabase -> uploads to a Supabase Storage bucket. Needs the vars above.
#            Required on read-only filesystems (Vercel, most containers).
STORAGE_DRIVER=local

# Name of the Supabase bucket to use when STORAGE_DRIVER=supabase.
# It is created for you on first write.
STORAGE_BUCKET=vantage-media

# Public origin that OpenRouter can fetch start-frame images from.
# OpenRouter's servers must be able to REACH the URL you pass in
# `frame_images[].image_url.url`. On localhost that is impossible: the local
# driver is not publicly addressable.
#
# With `local` driver + image-to-video you therefore need one of:
#   a) a public tunnel, and set this to it:  npx localtunnel --port 3000
#   b) a real host (Vercel), where it is set for you
#   c) leave it blank -- the app then refuses image-to-video with an explicit
#      error naming this variable, instead of sending OpenRouter a URL that
#      cannot resolve.
PUBLIC_MEDIA_BASE_URL=

# -----------------------------------------------------------------------------
# Credits
# -----------------------------------------------------------------------------
# Free credits granted at signup. 1 credit = USD 0.01 of OpenRouter spend.
# 200 credits = $2.00, which is a few dozen cheap generations.
FREE_STARTING_CREDITS=200

# Refuse new jobs once total spend across all users exceeds this, in USD.
# Set to 0 to disable the cap. This is the guard that stops a runaway script
# from draining the account.
GLOBAL_DAILY_SPEND_CAP_USD=25

# Held from a user before an image or video job starts, then reconciled
# against the real billed cost. Must exceed the most expensive job you allow.
CREDIT_RESERVE_CEILING_USD=2.00

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
# Shared secret for POST /api/worker/tick. Any non-empty random string.
# On Vercel, set it so only your own deploy can advance your jobs.
WORKER_SECRET=change-me-to-a-long-random-string

# How many jobs one tick may advance. Keeps the request well inside the
# serverless execution-time limit on the free tier.
WORKER_BATCH_SIZE=5

# A job not completed within this many minutes is marked expired and refunded.
JOB_MAX_AGE_MINUTES=30

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Per user, per rolling hour.
RATE_LIMIT_JOBS_PER_HOUR=10

# Simultaneous queued+generating jobs allowed per user.
MAX_CONCURRENT_JOBS_PER_USER=2

# -----------------------------------------------------------------------------
# Prompt enhancer
# -----------------------------------------------------------------------------
# Any cheap chat model on OpenRouter. Prompt enhancement costs a fraction of a
# cent and is billed to the user's credits like everything else.
ENHANCER_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Webhooks (optional -- polling works without this)
# -----------------------------------------------------------------------------
# If set, jobs are submitted with a callback_url so OpenRouter notifies us the
# moment a job reaches a terminal state, instead of waiting for the next poll.
# Set OPENROUTER_WEBHOOK_SECRET in your OpenRouter workspace settings too, or
# signatures cannot be verified and the webhook is rejected.
OPENROUTER_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Comma-separated emails allowed to reach /admin. Falls back to the
# is_admin flag in the database if this is empty.
ADMIN_EMAILS=
